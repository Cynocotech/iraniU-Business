# Copy to .env and fill in. Required for signing JWTs in production.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite: listings/directory vs logins are separate files (identity DB is ATTACHed as schema `identity`).
# Legacy single file (optional): if set and iraniu-directory.db does not exist yet, it is copied there once.
# SQLITE_PATH=./data/iraniu.db
# SQLITE_DIRECTORY_PATH=./data/iraniu-directory.db
# SQLITE_IDENTITY_PATH=./data/iraniu-identity.db

# Used only when the super_admins table is empty: creates the first super admin on server start.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=your-secure-password

# Optional: Telegram alert on each successful super-admin login (/admin/login only).
# You can also set these from the super-admin UI: Admin → امنیت و ۲FA → پیکربندی تلگرام (stored in SQLite, overrides .env).
# Token: @BotFather. Chat ID: numeric id from @userinfobot. Send /start to your bot once first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for "Kick out" inline button: same value as secret_token in setWebhook (HTTPS URL).
# Example: openssl rand -hex 24
# curl -F "url=https://YOUR_DOMAIN/api/telegram/webhook" -F "secret_token=YOUR_SECRET" https://api.telegram.org/bot<TOKEN>/setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Post businesses to the public directory channel (Admin → «ارسال به کانال تلگرام»).
# Same bot as above; add the bot as admin in the channel with «Post messages».
# Channel: @YourChannelUsername or numeric id like -1001234567890
TELEGRAM_DIRECTORY_CHANNEL_ID=
# Public site URL for links and resolving /uploads/... images (HTTPS in production).
PUBLIC_SITE_URL=https://your-domain.example

# Optional SMTP (used by notification features if enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=1
EMAIL_FROM="Iraniu <no-reply@iraniu.uk>"

# Twilio call tracking (optional)
# Set your Twilio phone number per business in dashboard fields.
# Configure Twilio Voice webhook URL to: https://YOUR_DOMAIN/api/twilio/voice/incoming
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Brute-force protection (manager + super-admin login): block IP after failed attempts in a time window.
# Maximum failed login attempts before blocking (default: 8, recommended: 5)
AUTH_BRUTE_MAX_FAILS=5
# Time window for counting failures in milliseconds (default: 900000 = 15 minutes)
AUTH_BRUTE_WINDOW_MS=900000
# How long to block after max fails in milliseconds (default: 1800000 = 30 minutes)
AUTH_BRUTE_BLOCK_MS=1800000

# Behind nginx/caddy: set so X-Forwarded-For is used for client IP (brute-force + Telegram).
# TRUST_PROXY=1

# AWS S3 Configuration (for file uploads - exchange banners, listing images)
# Leave empty to use local filesystem storage. When set, all new uploads go to S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudflare Turnstile Captcha (for login protection)
# Get keys from: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SECRET_KEY=your-secret-key-here

# OpenAI — AI search (embeddings: text-embedding-3-small, LLM: gpt-4o-mini)
# Run the migration and embedding job before enabling: see AI_SEARCH.md
OPENAI_API_KEY=sk-...
