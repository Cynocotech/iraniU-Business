# Core runtime
NODE_ENV=production
PORT=3001
TRUST_PROXY=1

# Security
JWT_SECRET=change-this-to-a-long-random-string

# Initial super admin (used only if super_admins table is empty on first boot)
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# Public URL (used in links and image URL resolving)
PUBLIC_SITE_URL=https://job.iraniu.uk

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIRECTORY_CHANNEL_ID=

# Email / SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=Iraniu <no-reply@iraniu.uk>

# Twilio (optional call tracking)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional login throttle tuning
# AUTH_BRUTE_MAX_FAILS=8
# AUTH_BRUTE_WINDOW_MS=900000
# AUTH_BRUTE_BLOCK_MS=1800000
